{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "horizon-push",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{"name": "HUB", "class_name": "Hub"}]
  },
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["Hub"]}],
  // Keeps the listener up if its own watchdog alarm ever stops
  "triggers": {"crons": ["* * * * *"]}
  // FCM_SERVICE_ACCOUNT is a secret (wrangler secret put), never in this file
}
